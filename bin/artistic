set -eu

root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
PYTHONPATH="$root"
PYTHONNOUSERSITE=1
export PYTHONPATH PYTHONNOUSERSITE
if [ -n "${PYTHON:-}" ]; then
    python=$PYTHON
elif command -v python3.11 >/dev/null 2>&1; then
    python=python3.11
else
    python=python3
fi
exec "$python" -m artistic "$@"
